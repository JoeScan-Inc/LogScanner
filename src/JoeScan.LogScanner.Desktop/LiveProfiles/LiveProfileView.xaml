<UserControl
    x:Class="JoeScan.LogScanner.Desktop.LiveProfiles.LiveProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="http://oxyplot.org/wpf"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <oxy:PlotView
            Margin="0"
            Padding="0"
            Model="{Binding LiveView}" />
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource InterThin}"
            FontSize="44"
            Visibility="{Binding PausedIndicatorVisibility}">
            Paused
        </TextBlock>
        <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <Grid.Resources>
                <Style 
                    TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="FontSize" Value="10"></Setter>
                    <Setter Property="Margin" Value="3,1"></Setter>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0">Sequence:</TextBlock>
            <TextBlock Typography.NumeralAlignment="Tabular" MinWidth="80" Grid.Row="0" Grid.Column="1" Text="{Binding SequenceNumber}" TextAlignment="Right" />
            
            <TextBlock Grid.Row="1" Grid.Column="0">Enc. Value:</TextBlock>
            <TextBlock Typography.NumeralAlignment="Tabular" Grid.Row="1" Grid.Column="1" Text="{Binding EncoderValue}" TextAlignment="Right" />
            
            <TextBlock Grid.Row="2" Grid.Column="0">Direction:</TextBlock>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Direction}" HorizontalAlignment="Right" />
        </Grid>
        
        <StackPanel
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <ToggleButton
                x:Name="Paused"
                Width="24"
                Height="24"
                Margin="3"
                Padding="3"
                DockPanel.Dock="Right"
                Focusable="False"
                Style="{StaticResource {x:Type ToggleButton}}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MaterialDesignIcons}"
                    FontSize="16">
                    &#xF1592;
                </TextBlock>
                <ToggleButton.ToolTip>
                    <TextBlock>Pause the Live Display. Acquisition and Measurement will not be affected.</TextBlock>
                </ToggleButton.ToolTip>
            </ToggleButton>
            <ToggleButton
                x:Name="ShowFilters"
                Width="24"
                Height="24"
                Margin="3"
                Padding="3"
                DockPanel.Dock="Right"
                Focusable="False"
                Style="{StaticResource {x:Type ToggleButton}}">
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MaterialDesignIcons}"
                    FontSize="16">
                    &#xF0485;
                </TextBlock>
                <ToggleButton.ToolTip>
                    <TextBlock>Show/Hide Raw Profile Filter Outlines.</TextBlock>
                </ToggleButton.ToolTip>
            </ToggleButton>
        </StackPanel>
    </Grid>
</UserControl>
